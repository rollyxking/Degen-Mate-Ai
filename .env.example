# =====================================================================
#  DegenMateCoin Meme Lab - configuration (copy to server/.env)
#  Image generation uses Pollinations (https://gen.pollinations.ai/docs).
#  Secrets live ONLY in server/.env - never use a VITE_ prefix for them.
# =====================================================================

# ---- Image provider (Pollinations) ----
# Required. Create a free account and a SECRET key (starts with sk_) at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=sk_k9NGb5L8plcVqj2L4Eyl3lPeYSxx30wk
# Optional. Leave empty for the provider's documented default (tongyi-mai/z-image-turbo).
# See the live list at https://gen.pollinations.ai/image/models
POLLINATIONS_MODEL=
PROVIDER_TIMEOUT_SEC=90         # per image
PROVIDER_MAX_CONCURRENT=2       # parallel calls to the provider (free tiers rate-limit)
MAX_QUEUED_JOBS=2               # requests allowed to wait behind the one being generated

# ---- Optional local caption model (Ollama). Empty = built-in caption bank. ----
OLLAMA_URL=
OLLAMA_MODEL=llama3.2:3b

# ---- Generation settings ----
IMAGE_SIZE=1024x1024
ALLOWED_SIZES=1024x1024,1024x768,768x1024
MAX_IMAGES_PER_REQUEST=2      # allowed counts are 1, 2, 4, 8 up to this cap. Each image uses free allowance.
DAILY_QUOTA=20                # images per visitor per day (protects YOUR free allowance)
RATE_LIMIT_PER_MIN=6          # generate requests per IP per minute

# ---- Optional auth: if set, visitors must enter this code ----
ACCESS_CODE=

PORT=8787
DATA_DIR=./data
